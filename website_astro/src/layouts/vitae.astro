---
import Base from "../layouts/base.astro"
import Scrollspy from "../components/Scrollspy.astro"
const { title, ...props  } = Astro.props;
---

<Base title={title}>
	<div class="min-h-screen flex flex-row relative w-screen">
		<aside class="hidden px-2 lg:flex lg:w-2/5"/>
		<main class="w-full flex-grow max-w-4xl px-4 my-4" style="min-width: 512px;">
				<slot />
		</main>
		<aside class="hidden px-2 lg:flex lg:w-2/5">
			<Scrollspy/>
		</aside>
	</div>
</Base>
