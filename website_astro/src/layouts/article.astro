---
import BaseLayout from '../layouts/base.astro';
const { title, ...props  } = Astro.props;
---

<BaseLayout title={title}>
  <main class="items-center mx-auto max-w-none pb-16">
    <div class="py-2 px-12 mx-auto max-w-4xl prose prose-sm lead-3 prose-blockquote bg-white/80 min-h-full rounded-xl mt-2">
      <slot />
    </div>
  </main>
</BaseLayout>
