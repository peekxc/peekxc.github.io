---
import BaseLayout from '../layouts/base.astro';
const { title, ...props  } = Astro.props;
---

<BaseLayout title={title}>
	<main class="items-center m-0 mx-auto max-w-none min-h-max">
		<div class="px-12 mx-auto max-w-4xl prose prose-sm lead-3 prose-blockquote">
			<slot />
		</div>
	</main>
</BaseLayout>