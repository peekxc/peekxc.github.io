---
import BaseLayout from '../layouts/base.astro';
const { title, ...props  } = Astro.props;
---

<BaseLayout title={title}>
  <main class="items-center mx-auto max-w-none py-1">
	<!-- https://flyonui.com/blog/glassmorphism-with-tailwind-css -->
    <div class="py-4 px-12 mx-auto max-w-4xl prose prose-sm lead-3 prose-blockquote bg-white/70 shadow-xl min-h-full rounded-xl mt-2">
      <slot />
    </div>
  </main>
</BaseLayout>
