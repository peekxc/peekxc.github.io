---
import { Image } from 'astro:assets';
import Head from "../components/head.astro";
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import ScriptMenu from "../components/script_menu.astro"
const { title, ...props  } = Astro.props;
---
<html>
  <head>
    <meta charset="utf-8">
    <Head title={title} />
  </head>
  <body>
    <Navbar />
    <main class="items-center m-0 mx-auto max-w-none">
      <div class="px-12 mx-auto max-w-4xl prose prose-sm lead-3 prose-blockquote">
          <h1 class="my-4"> Matt Piekenbrock </h1>
          <div class="w-full" id="page_content">
              <h1 class="mb-0"></h1>
              <div class="inline-block my-2">
                <a class="px-1 px-2 mr-1 min-w-0 text-xs text-black bg-neutral-300 rounded-xs" style="padding: 0.375rem 0.375rem 0.5rem 0.5rem; white-space: nowrap;"> 
                </a>
                  <span class="mr-2 w-4 h-4 text-black align-middle bg-center bg-no-repeat"/>
                  <span class="px-1 px-2 mr-1 min-w-0 text-xs text-black bg-neutral-300 rounded-xs" style="padding: 0.375rem 0.375rem 0.5rem 0.5rem; white-space: nowrap;"> 
                  </span>
              </div>
          </div>
          <br />
          <slot />
      </div>
    </main>


    <!-- <main class="grid grid-cols-1 md:grid-cols-12">
      <aside class="hidden md:block md:col-span-2">
        <article class="mx-auto w-full text-justify md:col-span-8 px-4" style="max-width: 85ch;"> 
          <div class="prose prose-base prose-article">
            <slot />
          </div>
        </article>
      </aside>
    </main> -->
    <Footer/>
		<ScriptMenu/>
		<script defer src="/_vercel/speed-insights/script.js"/>
		<script defer src="/_vercel/insights/script.js"/>
  </body>
</html>