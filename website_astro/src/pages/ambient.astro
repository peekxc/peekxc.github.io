---
import Base from '../layouts/base.astro';
import AmbientMesh from '../components/AmbientMesh.astro';
---

<Base>
  <section class="relative min-h-screen overflow-hidden bg-slate-950/70 text-white">
    <AmbientMesh />
    <div class="relative z-10 mx-auto flex min-h-screen flex-col items-center justify-center space-y-4 px-6 py-24 text-center">
      <p class="text-xs uppercase tracking-[0.6em] text-slate-400">Ambient</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl">
        Whispers in the mesh
      </h1>
      <p class="mt-4 max-w-2xl text-base text-slate-300 sm:text-lg">
        Floating points and inked edges dancing slowly together. This slice of the
        site explores a monochrome Delaunay background that pulses with a calm, generative hum.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="rounded-full border border-white/60 px-6 py-3 text-sm font-semibold uppercase tracking-[0.4em] text-white transition hover:bg-white hover:text-slate-900">
          Return Home
        </a>
        <a href="/blog" class="rounded-full border border-white/30 px-6 py-3 text-sm font-semibold uppercase tracking-[0.4em] text-white/70 transition hover:border-white hover:text-white">
          View Blog
        </a>
      </div>
    </div>
  </section>
</Base>
