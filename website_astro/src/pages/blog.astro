---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../layouts/base.astro';
import BlogCard from '../components/BlogCard.astro';

type BlogPost = CollectionEntry<'blog_posts'>;

const posts: BlogPost[] = await getCollection('blog_posts');
const published_posts = posts.filter((post): post is BlogPost => !post.data.draft);
const sorted_posts = [...published_posts].sort((a, b) => {
  const aDate = Date.parse(a.data.date ?? '');
  const bDate = Date.parse(b.data.date ?? '');
  return (bDate || 0) - (aDate || 0);
});
---

<Base>
  <main class="px-4 py-10 sm:px-6 lg:px-12">
    <div class="mx-auto max-w-6xl space-y-6">
      <header class="space-y-2">
        <p class="text-xs font-semibold uppercase tracking-[0.5em] text-slate-500">Newsroom</p>
        <h1 class="text-3xl font-semibold text-slate-900">Blog</h1>
        <p class="text-sm text-slate-600">
          Essays about coding, geometry, algorithms, and computing.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2">
        {sorted_posts.map((post: BlogPost) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </main>
</Base>
