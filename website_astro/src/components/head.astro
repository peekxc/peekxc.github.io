---
interface Props {
  title: string;
}
const { title  } = Astro.props;
---
<head>
  <title> {title} </title>
  <meta charset="utf-8"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="viewport" content="initial-scale=1.0, width=device-width"/>
  <meta name="description" content="Personal website of Matthew Piekenbrock - research, background, curriculum vitae, and work experience."/>
  <meta name="author" content="Matthew Piekenbrock"/>
  <link rel="canonical" href="https://mattpiekenbrock.com"/>
  <!-- <link rel="stylesheet" type="text/css" href="/styles/tw_styles.css"/> -->
  <!-- <link rel="stylesheet" type="text/css" href="/styles/overrides.css"/> -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
</head>