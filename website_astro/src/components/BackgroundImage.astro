---
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

interface Props {
  imagePath: string;
  altText: string;
  size?: string;
}

const { imagePath, altText, size = '100' } = Astro.props as Props;
const imageEntry = imagePath ? images[imagePath] : undefined;
const imageMeta = imageEntry?.default;
---

{console.log(imageMeta)}
<div
  aria-label={altText}
  class="relative overflow-hidden rounded-t-sm bg-transparent bg-clip-border px-4 py-2"
>
  {imagePath && (
    <Image
      alt={altText}
      src={imageMeta}
      formats={['avif', 'webp']}
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
      style="opacity: 0.35;"
      width="682"
      quality="5"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-br from-white/90 via-white/30 to-transparent" />
  <div class="relative z-10 h-full w-full">
    <slot class="grayscale transition-transform duration-500" />
  </div>
</div>
