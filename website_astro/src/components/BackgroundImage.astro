---
interface Props {
	imagePath: string;
	altText: string;
	size: string;
}
const { imagePath, altText, size } = Astro.props;

const images = import.meta.glob<string>(
	'/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif,svg}',
	{ eager: true, import: 'default', query: '?url' }
);

const requestedPath = imagePath?.trim();
const exactMatch = requestedPath ? images[requestedPath] : undefined;
const basename = requestedPath?.split('/').pop();
const fallbackKey = basename
	? Object.keys(images).find((key) => key.endsWith(`/${basename}`))
	: undefined;

const resolvedImage = exactMatch ?? (fallbackKey ? images[fallbackKey] : undefined) ?? requestedPath;
const backgroundStyle = resolvedImage
	? `background-image: url(${resolvedImage}); background-size: ${size}% !important;`
	: `background-size: ${size}% !important;`;
---
<!-- { console.log(optimizedBackground) } -->
<!-- bg-neutral-200  -->
<!-- `background-image: url(${optimizedBackground.src});  -->
<div 
	aria-label={altText}
	class={`
		overflow-hidden
		transition-all duration-300 
		bg-white/85 bg-backdrop-blur-sm 
		bg-cover bg-clip-border bg-no-repeat bg-right bg-blend-overlay
		px-4 py-2 m-0 
		bg-backdrop-filter-xs
		inset-0
		w-full h-full
		rounded-t-sm
	`}
	style={backgroundStyle}
>
	<slot class="grayscale transition-transform duration-500 backdrop-blur-sm"/>
</div>
