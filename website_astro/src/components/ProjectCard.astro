---
import { Icon } from 'astro-icon/components';
import ProjectCardImage from './ProjectCardImage.astro';

interface SectionItem {
  label: string;
  href?: string;
  meta?: string;
}

interface Section {
  title: string;
  items: SectionItem[];
}

interface Publication {
  title: string;
  href?: string;
  meta?: string;
}

interface SoftwareHighlight {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  abstract: string;
  tags: string[];
  image?: string;
  highlightDate?: string;
  sections?: Section[];
  publications?: Publication[];
  software?: SoftwareHighlight[];
}

const {
  title,
  subtitle,
  abstract,
  tags,
  image,
  highlightDate,
  sections = [],
  publications = [],
  software = []
} = Astro.props as Props;
const hasMedia = Boolean(image);
const panelId = `project-panel-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<article data-project-card class="group w-full rounded-2xl border border-slate-200 bg-white/90 shadow-sm transition hover:shadow-md">
  {hasMedia && (
    <div class="relative h-40 overflow-hidden rounded-t-2xl">
      <ProjectCardImage
        imagePath={image}
        alt={title}
        className="m-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
      <p class="absolute bottom-2 right-3 text-[0.6rem] font-semibold uppercase tracking-[0.4em] text-white/80">{highlightDate ?? 'ongoing'}</p>
    </div>
  )}
  <div class="flex flex-col gap-2 px-4 py-4 text-slate-900">
    <button
      type="button"
      class="w-full text-left"
      data-accordion-trigger
      aria-controls={panelId}
      aria-expanded="false"
    >
      <div class="flex flex-wrap items-start justify-between gap-2">
        <div>
          <h3 class="text-xl font-semibold leading-snug mb-2 mt-0">{title}</h3>
          <p class="text-xs uppercase text-slate-500 leading-tight my-1">{subtitle}</p>
        </div>
      </div>

      <p
        class="mt-2 text-sm leading-relaxed text-slate-600"
        style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
      >
        {abstract}
      </p>

			<div class="mt-2 grid grid-cols-[1fr_auto] items-end gap-2">
				<div class="flex flex-wrap gap-1 text-slate-600">
					{tags.map((tag) => (
						<span class="rounded-md border border-slate-200 px-2 py-0.5 text-xs font-semibold tracking-[0.1em]">
							{tag}
						</span>
					))}
				</div>
				<span class="chevron-icon inline-flex justify-self-end self-end transition-transform duration-300 ease-in-out">
					<Icon name="chevron" width=18 height=18/>
				</span>
			</div>
			
    </button>

    <div
      id={panelId}
      data-accordion-content
      data-open="false"
      class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out"
    >
      <div class="overflow-hidden">
        <div class="space-y-2 border-t border-slate-200 pt-3">
          {hasMedia && (
            <ProjectCardImage
              imagePath={image}
              alt={`${title} detail image`}
              className="h-48 w-full rounded-xl border border-slate-200 object-cover"
            />
          )}
          <p class="text-sm leading-relaxed text-slate-700">{abstract}</p>

          <div class="space-y-2 pt-1">
            {sections.map((section) => (
              <section class="rounded-2xl border border-slate-200 bg-slate-50/60 p-3 text-sm text-slate-700">
                <div class="mb-1 text-[0.55rem] uppercase tracking-[0.4em] text-slate-500">{section.title}</div>
                <div class="grid gap-2 text-xs leading-tight">
                  {section.items.map((item) => (
                    <div class="flex items-center justify-between gap-2">
                      {item.href ? (
                        <a class="font-semibold text-slate-900 transition hover:text-primary" href={item.href} target="_blank" rel="noreferrer">
                          {item.label}
                        </a>
                      ) : (
                        <span class="font-semibold text-slate-900">{item.label}</span>
                      )}
                      {item.meta && <span class="text-[0.55rem] text-slate-500">{item.meta}</span>}
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  const initProjectAccordions = () => {
    document.querySelectorAll('[data-project-card]').forEach((card) => {
      if (card.getAttribute('data-accordion-bound') === 'true') return;

      const trigger = card.querySelector('[data-accordion-trigger]');
      const content = card.querySelector('[data-accordion-content]');
      const icon = card.querySelector('.chevron-icon');
      if (!trigger || !content) return;

      trigger.addEventListener('click', () => {
        const isOpen = content.getAttribute('data-open') === 'true';
        content.setAttribute('data-open', isOpen ? 'false' : 'true');
        content.classList.toggle('grid-rows-[1fr]', !isOpen);
        content.classList.toggle('grid-rows-[0fr]', isOpen);
        icon?.classList.toggle('rotate-180', !isOpen);
        trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      });

      card.setAttribute('data-accordion-bound', 'true');
    });
  };

  initProjectAccordions();
  document.addEventListener('astro:page-load', initProjectAccordions);
</script>
