---
const canvasId = 'ambient-canvas';
---

<div class="pointer-events-none fixed inset-0 -z-10 hidden md:block">
  <canvas id={canvasId} class="h-full w-full" aria-hidden="true"></canvas>
</div>

<script is:inline type="module">
  const canvas = document.getElementById('ambient-canvas');
  const ctx = canvas.getContext('2d');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mdMedia = window.matchMedia('(min-width: 768px)');
  
  const config = {
    maxJitter: 45,
    connectionRadius: 170,
    rgb: '0,0,0',
    bgColor: '#fdfdfd',
    edgeRange: [0.02, 0.42],
    fillRange: [0.0, 0.08],
    nodeAlpha: 0.38
  };
  
  let gridPoints = [];
  let width, height, animationId;
  let isActive = mdMedia.matches;
  const radiusSq = config.connectionRadius ** 2;
  const diameterSq = 2 * radiusSq;

  const createGrid = (cols, rows) => {
    gridPoints = [];
    const [colSpace, rowSpace] = [cols - 1 || 1, rows - 1 || 1];
    
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const baseX = (c / colSpace) * width + (Math.random() - 0.5) * width / cols * 0.45;
        const baseY = (r / rowSpace) * height + (Math.random() - 0.5) * height / rows * 0.45;
        gridPoints.push({
          baseX, baseY, x: baseX, y: baseY,
          phase: Math.random() * Math.PI * 2,
          offsetX: (0.4 + Math.random() * 0.6) * config.maxJitter,
          offsetY: (0.3 + Math.random() * 0.7) * config.maxJitter,
          speed: 0.14 + Math.random() * 0.10
        });
      }
    }
  };

  const resize = () => {
    const scale = window.devicePixelRatio || 1;
    width = Math.max(canvas.clientWidth, window.innerWidth);
    height = Math.max(canvas.clientHeight, window.innerHeight);
    canvas.width = width * scale;
    canvas.height = height * scale;
    ctx.setTransform(scale, 0, 0, scale, 0, 0);
    
    const cols = Math.max(6, Math.min(18, Math.floor(width / 140)));
    const rows = Math.max(4, Math.min(12, Math.floor(height / 140)));
    createGrid(cols, rows);
  };

  const updatePoints = (t) => {
    gridPoints.forEach(p => {
      const phase = t * p.speed + p.phase;
      p.x = p.baseX + Math.sin(phase) * p.offsetX;
      p.y = p.baseY + Math.cos(phase) * p.offsetY;
    });
  };

  const draw = () => {
    if (!isActive) return;
    
    ctx.fillStyle = config.bgColor;
    ctx.fillRect(0, 0, width, height);
    ctx.lineWidth = 0.8;
    
    const neighbors = gridPoints.map(() => []);
    const clamp = v => Math.min(1, Math.max(0, v));
    const lerp = (min, max, t) => min + t * (max - min);
    
    // Draw edges and build neighbor lists
    for (let i = 0; i < gridPoints.length; i++) {
      const a = gridPoints[i];
      for (let j = i + 1; j < gridPoints.length; j++) {
        const b = gridPoints[j];
        const distSq = (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
        
        if (distSq <= diameterSq) {
          const weight = clamp(1 - distSq / diameterSq);
          const alpha = lerp(...config.edgeRange, weight);
          
          ctx.beginPath();
          ctx.strokeStyle = `rgba(${config.rgb},${alpha})`;
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
          
          neighbors[i].push({ i: j, w: weight });
          neighbors[j].push({ i, w: weight });
        }
      }
    }
    
    // Draw triangles
    for (let i = 0; i < gridPoints.length; i++) {
      const origin = gridPoints[i];
      const ns = neighbors[i];
      
      for (let m = 0; m < ns.length; m++) {
        for (let n = m + 1; n < ns.length; n++) {
          const [mi, ni] = [ns[m].i, ns[n].i];
          if (!(i < mi && i < ni && mi < ni)) continue;
          
          const [first, second] = [gridPoints[mi], gridPoints[ni]];
          const distSq = (first.x - second.x) ** 2 + (first.y - second.y) ** 2;
          
          if (distSq <= diameterSq) {
            const w3 = clamp(1 - distSq / diameterSq);
            const avg = (ns[m].w + ns[n].w + w3) / 3;
            const smooth = avg * avg * (3 - 2 * avg);
            const alpha = lerp(...config.fillRange, smooth);
            
            ctx.fillStyle = `rgba(${config.rgb},${alpha})`;
            ctx.beginPath();
            ctx.moveTo(origin.x, origin.y);
            ctx.lineTo(first.x, first.y);
            ctx.lineTo(second.x, second.y);
            ctx.fill();
          }
        }
      }
    }
    
    // Draw nodes
    ctx.fillStyle = `rgba(${config.rgb},${config.nodeAlpha})`;
    gridPoints.forEach(p => {
      ctx.beginPath();
      ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
      ctx.fill();
    });
  };

  const animate = (time) => {
    if (!isActive) return;
    updatePoints(time * 0.001);
    draw();
    animationId = requestAnimationFrame(animate);
  };

  const handleMediaChange = () => {
    isActive = mdMedia.matches;
    if (!isActive) {
      if (animationId) cancelAnimationFrame(animationId);
      animationId = null;
      ctx.clearRect(0, 0, width, height);
    } else if (!prefersReducedMotion && !animationId) {
      animationId = requestAnimationFrame(animate);
    }
  };

  const init = () => {
    resize();
    if (prefersReducedMotion) {
      updatePoints(0);
      draw();
    } else {
      handleMediaChange();
    }
  };

  window.addEventListener('resize', () => {
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
    resize();
    if (prefersReducedMotion) {
      updatePoints(0);
      draw();
    } else {
      handleMediaChange();
    }
  });

  mdMedia.addEventListener('change', () => {
    handleMediaChange();
    if (isActive) resize();
  });

  init();
</script>