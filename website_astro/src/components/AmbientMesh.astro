---
const canvasId = 'ambient-canvas';
---

<div class="pointer-events-none fixed inset-0 -z-10 hidden md:block">
  <canvas id={canvasId} class="h-full w-full" aria-hidden="true" data-noise="true" data-radius-connections="true"></canvas>
</div>

<script is:inline type="module">
  const canvas = document.getElementById('ambient-canvas');
  if (!canvas) {
    throw new Error('Ambient mesh canvas not found');
  }

  const ctx = canvas.getContext('2d');
  if (!ctx) {
    throw new Error('Unable to fetch canvas context');
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mdMedia = window.matchMedia('(min-width: 768px)');
  const columnsBase = 14;
  const rowsBase = 12;
  const maxJitter = 45;
  let connectionRadius = 170;
  const useNoise = canvas.dataset.noise !== 'false';
  const useRadiusConnections = true; // canvas.dataset.radiusConnections !== 'false';
  const lightTheme = true; // canvas.dataset.lightTheme === 'true';
  const rgbChannel = lightTheme ? '0,0,0' : '255,255,255';
  const backgroundColor = lightTheme ? '#fdfdfd' : '#020202';
  const gridPoints = [];
  let width = 0;
  let height = 0;
  let animationId;
  let columns = columnsBase;
  let rows = rowsBase;
  let isActive = mdMedia.matches;

  const createGrid = () => {
    gridPoints.length = 0;
    const columnSpace = columns > 1 ? columns - 1 : 1;
    const rowSpace = rows > 1 ? rows - 1 : 1;
    for (let row = 0; row < rows; row += 1) {
      const rowPoints = [];
      for (let column = 0; column < columns; column += 1) {
        const normalizedX = column / columnSpace;
        const normalizedY = row / rowSpace;
        const noiseX = useNoise ? (Math.random() - 0.5) * (width / columns) * 0.45 : 0;
        const noiseY = useNoise ? (Math.random() - 0.5) * (height / rows) * 0.45 : 0;
        const baseX = normalizedX * width + noiseX;
        const baseY = normalizedY * height + noiseY;
        rowPoints.push({
          baseX,
          baseY,
          x: baseX,
          y: baseY,
          phase: Math.random() * Math.PI * 2,
          offsetX: (0.4 + Math.random() * 0.6) * maxJitter,
          offsetY: (0.3 + Math.random() * 0.7) * maxJitter,
          speed: 0.10 + Math.random() * 0.10,
        });
      }
      gridPoints.push(rowPoints);
    }
  };

  const determineGrid = () => {
    columns = Math.max(6, Math.min(18, Math.floor(width / 140)));
    rows = Math.max(4, Math.min(12, Math.floor(height / 140)));
  };

  const resize = () => {
    const scale = window.devicePixelRatio || 1;
    width = Math.max(canvas.clientWidth, window.innerWidth);
    height = Math.max(canvas.clientHeight, window.innerHeight);
    canvas.width = width * scale;
    canvas.height = height * scale;
    ctx.setTransform(scale, 0, 0, scale, 0, 0);
    determineGrid();
    createGrid();
    // connectionRadius = Math.max(90, Math.min(width, height) * 0.28);
  };

  const updatePoints = (time) => {
    const t = time * 0.001;
    gridPoints.forEach((rowPoints) => {
      rowPoints.forEach((point) => {
        const jitter = Math.sin(t * point.speed + point.phase);
        point.x = point.baseX + jitter * point.offsetX;
        point.y = point.baseY + Math.cos(t * point.speed + point.phase) * point.offsetY;
      });
    });
  };

  const draw = () => {
    if (!isActive) return;
    ctx.fillStyle = backgroundColor;
    ctx.fillRect(0, 0, width, height);
    ctx.lineWidth = 0.8;
    ctx.strokeStyle = `rgba(${rgbChannel},0.18)`;

    if (useRadiusConnections) {
      const flattened = gridPoints.flat();
      const radiusSquared = connectionRadius * connectionRadius;
      const diameterSq = 2 * radiusSquared; 
      const neighborsList = flattened.map(() => []);

      const clamp = (value) => Math.min(1, Math.max(0, value));
      const edgeMin = 0.02;
      const edgeMax = 0.42;
      const fillMin = 0.0;
      const fillMax = 0.08;

      // Edges
      for (let i = 0; i < flattened.length; i += 1) {
        const a = flattened[i];
        for (let j = i + 1; j < flattened.length; j += 1) {
          const b = flattened[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const distanceSq = dx * dx + dy * dy;
          if (distanceSq <= diameterSq) {
            const normalized = clamp(1 - (distanceSq / diameterSq)); // between [0,1]
            const edgeAlpha = edgeMin + normalized * (edgeMax - edgeMin);
            ctx.beginPath();
            ctx.strokeStyle = `rgba(${rgbChannel},${edgeAlpha})`;
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
            neighborsList[i].push({ index: j, weight: normalized });
            neighborsList[j].push({ index: i, weight: normalized });
          }
        }
      }

      // Triangles (i,m,n)
      for (let i = 0; i < flattened.length; i += 1) {
        const origin = flattened[i];
        const neighbors = neighborsList[i];
        for (let m = 0; m < neighbors.length; m += 1) {
          for (let n = m + 1; n < neighbors.length; n += 1) {
            const firstIdx = neighbors[m].index;
            const secondIdx = neighbors[n].index;
            if (!(i < firstIdx && i < secondIdx && firstIdx < secondIdx)) continue;
            const first = flattened[firstIdx];
            const second = flattened[secondIdx];
            if (!first || !second) continue;
            const dx = first.x - second.x;
            const dy = first.y - second.y;
            const distanceSq = dx * dx + dy * dy;
            if (distanceSq > diameterSq) continue;
            const thirdWeight = clamp(1 - (distanceSq / diameterSq));
            const triangleWeight = (neighbors[m].weight + neighbors[n].weight + thirdWeight) / 3;
            const smooth = triangleWeight * triangleWeight * (3 - 2 * triangleWeight);
            const fillAlpha = fillMin + smooth * (fillMax - fillMin);
            ctx.beginPath();
            ctx.fillStyle = `rgba(${rgbChannel},${fillAlpha})`;
            ctx.moveTo(origin.x, origin.y);
            ctx.lineTo(first.x, first.y);
            ctx.lineTo(second.x, second.y);
            ctx.closePath();
            ctx.fill();
          }
        }
      }
    }

    const nodeAlpha = lightTheme ? 0.38 : 0.65;
    ctx.fillStyle = `rgba(${rgbChannel},${nodeAlpha})`;
    gridPoints.flat().forEach((point) => {
      ctx.beginPath();
      ctx.arc(point.x, point.y, 2, 0, Math.PI * 2);
      ctx.fill();
    });
  };

  const animate = (time) => {
    if (!isActive) return;
    updatePoints(time);
    draw();
    animationId = window.requestAnimationFrame(animate);
  };

  const handleMediaChange = () => {
    isActive = mdMedia.matches;
    if (!isActive) {
      if (animationId) {
        window.cancelAnimationFrame(animationId);
        animationId = null;
      }
      ctx.clearRect(0, 0, width, height);
    } else if (!prefersReducedMotion && !animationId) {
      animationId = window.requestAnimationFrame(animate);
    }
  };

  const init = () => {
    resize();
    if (prefersReducedMotion) {
      updatePoints(0);
      draw();
      return;
    }
    handleMediaChange();
  };

  window.addEventListener('resize', () => {
    if (animationId) {
      window.cancelAnimationFrame(animationId);
      animationId = null;
    }
    resize();
    if (prefersReducedMotion) {
      updatePoints(0);
      draw();
      return;
    }
    handleMediaChange();
  });

  mdMedia.addEventListener('change', () => {
    handleMediaChange();
    if (isActive) {
      resize();
    }
  });

  init();
</script>
