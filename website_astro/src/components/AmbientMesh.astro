---
const canvasId = 'ambient-canvas';
---

<div class="pointer-events-none fixed inset-0 -z-10">
<canvas id={canvasId} class="h-full w-full" aria-hidden="true" data-noise="true"></canvas>
</div>

<script is:inline type="module">
  const canvas = document.getElementById('ambient-canvas');
  if (!canvas) {
    throw new Error('Ambient mesh canvas not found');
  }

  const ctx = canvas.getContext('2d');
  if (!ctx) {
    throw new Error('Unable to fetch canvas context');
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const columns = 12;
  const rows = 8;
  const maxJitter = 45;
  const useNoise = canvas.dataset.noise !== 'false';
  const gridPoints = [];
  let width = 0;
  let height = 0;
  let animationId;

  const createGrid = () => {
    gridPoints.length = 0;
    const columnSpace = columns > 1 ? columns - 1 : 1;
    const rowSpace = rows > 1 ? rows - 1 : 1;
    for (let row = 0; row < rows; row += 1) {
      const rowPoints = [];
      for (let column = 0; column < columns; column += 1) {
        const normalizedX = column / columnSpace;
        const normalizedY = row / rowSpace;
        const noiseX = useNoise ? (Math.random() - 0.5) * (width / columns) * 0.45 : 0;
        const noiseY = useNoise ? (Math.random() - 0.5) * (height / rows) * 0.45 : 0;
        const baseX = normalizedX * width + noiseX;
        const baseY = normalizedY * height + noiseY;
        rowPoints.push({
          baseX,
          baseY,
          x: baseX,
          y: baseY,
          phase: Math.random() * Math.PI * 2,
          offsetX: (0.4 + Math.random() * 0.6) * maxJitter,
          offsetY: (0.3 + Math.random() * 0.7) * maxJitter,
          speed: 0.4 + Math.random() * 0.6,
        });
      }
      gridPoints.push(rowPoints);
    }
  };

  const resize = () => {
    const scale = window.devicePixelRatio || 1;
    width = Math.max(canvas.clientWidth, window.innerWidth);
    height = Math.max(canvas.clientHeight, window.innerHeight);
    canvas.width = width * scale;
    canvas.height = height * scale;
    ctx.setTransform(scale, 0, 0, scale, 0, 0);
    createGrid();
  };

  const updatePoints = (time) => {
    const t = time * 0.001;
    gridPoints.forEach((rowPoints) => {
      rowPoints.forEach((point) => {
        const jitter = Math.sin(t * point.speed + point.phase);
        point.x = point.baseX + jitter * point.offsetX;
        point.y = point.baseY + Math.cos(t * point.speed + point.phase) * point.offsetY;
      });
    });
  };

  const draw = () => {
    ctx.fillStyle = '#020202';
    ctx.fillRect(0, 0, width, height);
    ctx.lineWidth = 0.8;
    ctx.strokeStyle = 'rgba(255,255,255,0.18)';

    for (let row = 0; row < rows - 1; row += 1) {
      for (let column = 0; column < columns - 1; column += 1) {
        const pA = gridPoints[row][column];
        const pB = gridPoints[row][column + 1];
        const pC = gridPoints[row + 1][column];
        const pD = gridPoints[row + 1][column + 1];

        ctx.beginPath();
        ctx.moveTo(pA.x, pA.y);
        ctx.lineTo(pB.x, pB.y);
        ctx.lineTo(pD.x, pD.y);
        ctx.closePath();
        ctx.fillStyle = 'rgba(255,255,255,0.04)';
        ctx.fill();
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(pA.x, pA.y);
        ctx.lineTo(pD.x, pD.y);
        ctx.lineTo(pC.x, pC.y);
        ctx.closePath();
        ctx.fillStyle = 'rgba(255,255,255,0.03)';
        ctx.fill();
        ctx.stroke();
      }
    }

    ctx.beginPath();
    gridPoints.forEach((rowPoints) => {
      rowPoints.forEach((point, index) => {
        const next = rowPoints[index + 1];
        if (next) {
          ctx.moveTo(point.x, point.y);
          ctx.lineTo(next.x, next.y);
        }
      });
    });
    ctx.strokeStyle = 'rgba(255,255,255,0.26)';
    ctx.stroke();

    ctx.beginPath();
    for (let column = 0; column < columns; column += 1) {
      for (let row = 0; row < rows - 1; row += 1) {
        const point = gridPoints[row][column];
        const nextRow = gridPoints[row + 1][column];
        if (nextRow) {
          ctx.moveTo(point.x, point.y);
          ctx.lineTo(nextRow.x, nextRow.y);
        }
      }
    }
    ctx.strokeStyle = 'rgba(255,255,255,0.24)';
    ctx.stroke();

    ctx.fillStyle = 'rgba(255,255,255,0.65)';
    gridPoints.flat().forEach((point) => {
      ctx.beginPath();
      ctx.arc(point.x, point.y, 2, 0, Math.PI * 2);
      ctx.fill();
    });
  };

  const animate = (time) => {
    updatePoints(time);
    draw();
    animationId = window.requestAnimationFrame(animate);
  };

  const init = () => {
    resize();
    if (prefersReducedMotion) {
      updatePoints(0);
      draw();
      return;
    }
    animationId = window.requestAnimationFrame(animate);
  };

  window.addEventListener('resize', () => {
    if (animationId) {
      window.cancelAnimationFrame(animationId);
    }
    resize();
    if (!prefersReducedMotion) {
      animationId = window.requestAnimationFrame(animate);
    } else {
      updatePoints(0);
      draw();
    }
  });

  init();
</script>
