---
import type { CollectionEntry } from 'astro:content';
interface Props {
  post: CollectionEntry<'blog_posts'>;
}

const { post } = Astro.props as Props;
const frontmatter = post.data;
const hasImage = Boolean(frontmatter.background_image);
const imageSrc = hasImage
  ? frontmatter.background_image
  : undefined;
const publishedDate = frontmatter.date
  ? new Date(frontmatter.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
const summary = frontmatter.abstract ?? frontmatter.description ?? '';
const labels = frontmatter.categories?.length
  ? frontmatter.categories
  : frontmatter.tags ?? [];
const fallbackGradient = 'linear-gradient(135deg, #e2e8f0, #fecdd3)';
---

<a
  href={post.url}
  class="group block overflow-hidden rounded-3xl border border-slate-200 bg-white/80 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
  aria-label={`Read ${frontmatter.title}`}
>
  <article class="grid gap-6 p-6 md:grid-cols-[3fr_2fr]">
    <div class="flex flex-col gap-3">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-500">
        {publishedDate || 'Blog'}
      </p>
      <h3 class="text-2xl font-semibold leading-snug text-slate-900 transition-colors group-hover:text-primary">
        {frontmatter.title}
      </h3>
      {summary && (
        <p
          class="text-sm text-slate-600"
          style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
        >
          {summary}
        </p>
      )}

      <div class="flex flex-wrap gap-2">
        {labels.map((label) => (
          <span class="tag bg-slate-100 text-slate-600" aria-label={label}>
            {label}
          </span>
        ))}
      </div>
    </div>

    <div class="relative -m-2 h-48 overflow-hidden rounded-2xl border border-slate-100 bg-gradient-to-br from-slate-100 via-white to-slate-100 shadow-inner">
      {hasImage ? (
        <img
          src={imageSrc!}
          alt={`Preview for ${frontmatter.title}`}
          loading="lazy"
          class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center text-xs font-semibold uppercase tracking-[0.35em] text-slate-500"
          style={`background-image: ${fallbackGradient}`}
        >
          {labels[0] ?? 'Insight'}
        </div>
      )}

      {labels.length > 0 && (
        <span class="absolute inset-x-4 bottom-4 rounded-2xl border border-white/50 bg-white/70 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.3em] text-slate-600 shadow-lg backdrop-blur">
          {labels.slice(0, 2).join(' • ')}
        </span>
      )}
    </div>
  </article>
</a>
