---
import "../styles/tw.css"
const { title, subtitle, date, extra, description, tags } = Astro.props;
import { Icon } from 'astro-icon/components'
---

<div class="card shadow-xs bg-white leading-5">
	<div class="cursor-context-menu px-4 py-1 bg-neutral-200 m-0 bg-cover bg-clip-border bg-no-repeat bg-right bg-blend-overlay border-1 overflow-hidden hover:border-slate-500" style="background-image: url(); background-size: 60% !important;">
		<div class="accordion-header flex flex-col">
			<div class="flex flex-row justify-between">
				<h4 class="font-bold col-span-3"> { title }</h4>
				<h4 class="font-medium col-span-5 justify-self-end"> { subtitle }</h4>
			</div>
			<div class="flex flex-row justify-between">
					<h4 class="font-normal"> {date} </h4>
					<h4 class="font-normal"> {extra} </h4>
			</div>
			<hr class="col-span-full" style="margin-bottom: 0.20rem;" />
			<div class="flex flex-row justify-between items-center">
				<div class="flex flex-nowrap justify-between align-center">
					{ tags?.map((tag) =>
						<span class="span bg-neutral-300 text-black text-xs px-1 rounded-xs mr-1 min-w-0" style="white-space: nowrap; padding-top: 0.15em !important; padding-bottom: 0.15em !important"> { tag } </span>
					) }
				</div>
				<span class="flex-none">
					<Icon name="down_arrow">
					<Icon name="up_arrow"/>
				</span>
			</div>
			<!-- <span class="flex-grow truncate ..."> 
				{description}
			</span> -->
		</div>
	</div>
	<div class="accordion-body p-2 overflow-auto px-4 py-2 border-x-1 border-b-1 hidden">
		<slot/>
	</div>
</div>