---
import { Picture } from 'astro:assets';
import ProfileImage from "../assets/images/profile_pic_blue.jpg"
---

<div class="flex bg-neutral-100 rounded-lg border border-gray-400" style="mx-0 md:mx-8 lg:mx-16">
	<div class="flex flex-col p-2 my-auto justify-items-center">
		<Picture src={ProfileImage} alt="MJP profile pic" 
			class="object-cover rounded-t-md align-middle aspect-square"
			style="max-width: 14rem; width: 14rem; height: 14rem;"
		/>
		<div class="grid grid-cols-3">
			<a class="py-1.5 flex-auto" style="white-space: nowrap; background-color: #5087ed;">
				<span class="scholar_logo align-middle bg-no-repeat bg-center h-4 w-4 mx-auto"/>
			</a>
			<a class="py-1.5 flex-auto" style="white-space: nowrap; background-color: #000000;">
				<span class="github_logo align-middle bg-no-repeat bg-center h-4 w-4 mx-auto"/>
			</a>
			<a class="py-1.5 flex-auto" style="white-space: nowrap; background-color: #2a66bc;">
				<span class="linkedin_logo place-self-center-safe bg-no-repeat bg-center h-8 w-8 mx-auto"/>
			</a>
		</div>
	</div>
	<div class="flex flex-col justify-between px-3 overflow-y-scroll text-left py-2 flex-1">
			<h4 class="font-bold text-2xl antialiased">Matt Piekenbrock</h4>
			<summary class="prose-md leading-5 inline m-auto">
				<slot/>
			</summary>
	</div>
</div>

<style>

.github_logo {
	display: inline-block;
	background-image: url(../fonts/github_logo.svg);
}
.linkedin_logo {
	display: inline-block;
	background-image: url(../fonts/linkedin_logo.svg);
}
.scholar_logo {
	display: inline-block;
	background-image: url(../fonts/scholar_logo.svg);
}
</style>