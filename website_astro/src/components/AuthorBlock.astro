---
const { title, date, categories = [] } = Astro.props;
---
<h1 class="my-1 text-center">{title}</h1>
<p class="text-md text-center m-2 leading-tight text-slate-500 font-semibold">
	By: Matt Piekenbrock &nbsp;({date})
</p>
<div class="text-center space-x-1 align-middle">
	{categories.map(cat => (
		<span class="px-1 py-0 text-sm rounded-sm border">{cat}</span>
	))}
</div>
<hr class="my-2" />