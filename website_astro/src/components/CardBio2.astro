---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ProfileImage from "../assets/images/profile_pic_blue.jpg"
---

<div class="max-w-2xl mx-auto overflow-hidden bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 shadow-xl shadow-slate-200/50 dark:shadow-none flex flex-col md:flex-row items-center md:items-stretch transition-all hover:shadow-2xl mx-0" style="margin: 0;">
  
  <div class="w-full md:w-1/3 relative overflow-hidden group">
    <Picture 
      src={ProfileImage} 
      formats={['avif', 'webp']} 
      alt="Matt Piekenbrock" 
      class="h-full w-full object-cover aspect-square md:aspect-auto transform transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <div class="p-8 md:p-4 flex-1 flex flex-col">
    <div class="flex-1">
      <slot/>
    </div>

    <div class="flex flex-row justify-between items-stretch mt-auto pt-2 border-t border-slate-100 dark:border-slate-800">
      <a 
        href="/public/cv_7.pdf" 
        class="px-5 py-2.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-md font-semibold text-sm transition-all hover:bg-blue-600 dark:hover:bg-blue-500 hover:scale-105 active:scale-95 flex items-center gap-2"
      >
        <!-- <Icon name="mdi:file-document-outline" class="text-lg" /> -->
        View CV
      </a>

      <div class="flex items-center gap-4 text-slate-400 dark:text-slate-500">
        <a href="https://github.com/..." class="hover:text-slate-900 dark:hover:text-white transition-colors">
          <Icon name="github" class="text-2xl" />
        </a>
        <a href="https://linkedin.com/in/..." class="hover:text-blue-600 transition-colors">
          <Icon name="linkedin" class="text-2xl" />
        </a>
        <a href="https://scholar.google.com/..." class="hover:text-blue-400 transition-colors">
          <Icon name="scholar" class="text-2xl" />
        </a>
      </div>
    </div>
  </div>
</div>