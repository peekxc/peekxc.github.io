---
import Head from "../components/Head.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScriptMenu from "../components/ScriptMenu.astro"

interface Props {
  title?: string;
	description?: string;
	canonical?: string;
}

const { title, description, canonical } = Astro.props;	
---
<html lang="en">
  <Head 
		title={title}
		description={description}
		canonical={canonical}
	/>
  <!-- NOTE: don't use w-screen to avoid viewport changes reflows  -->
  <body class="min-h-screen flex flex-col w-full" style="-webkit-text-size-adjust: 100%;">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ScriptMenu />
    <!-- <script defer src="/_vercel/speed-insights/script.js"/>
    <script defer src="/_vercel/insights/script.js"/> -->
  </body>
</html>
