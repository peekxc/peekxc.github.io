  <!-- NOTE: don't use w-screen to avoid viewport changes reflows  -->
  <body class="min-h-screen flex flex-col min-w-sm w-full" style="-webkit-text-size-adjust: 100%;">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ScriptMenu />
    <!-- <script defer src="/_vercel/speed-insights/script.js"/>
