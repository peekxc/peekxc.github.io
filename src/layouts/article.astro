---
import Base from '../layouts/base.astro';
const { title  } = Astro.props;
---

<Base title={title}>
  <main class="items-center mx-auto max-w-none py-1">
	<!-- https://flyonui.com/blog/glassmorphism-with-tailwind-css -->
    <div class="py-4 px-4 md:px-6 lg:px-12 mx-auto max-w-4xl prose prose-sm lead-3 prose-blockquote bg-white/70 shadow-xl min-h-full rounded-xl my-4">
      <slot />
    </div>
  </main>
</Base>
