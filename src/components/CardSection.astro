---
const { title = "" } = Astro.props
---
<section class="my-2">
	<div class="flex items-center uppercase tracking-normal text-slate-400 font-bold text-xs mb-2">
		<span class="font-bold"> {title} </span>
	</div>
	<div class="overflow-auto pt-1 pb-2 bg-white-100 prose-md text-slate-800">
		<slot/>
	</div>
</section>

