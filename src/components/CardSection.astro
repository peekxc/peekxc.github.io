---
const { title = "" } = Astro.props
---
<section class="my-2">
	<div class="mb-2 flex items-center text-xs font-semibold uppercase tracking-[0.24em] text-ink-muted">
		<span>{title}</span>
	</div>
	<div class="card-section-body overflow-auto pb-2 pt-1 text-sm leading-snug text-ink">
		<slot/>
	</div>
</section>

<style>
	.card-section-body :global(p) {
		margin-block: 0.55rem;
	}

	.card-section-body :global(p:first-child) {
		margin-top: 0;
	}

	.card-section-body :global(p:last-child) {
		margin-bottom: 0;
	}

	.card-section-body :global(a) {
		color: var(--color-ink-strong);
		line-height: normal;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.card-section-body :global(a:hover),
	.card-section-body :global(a:focus-visible) {
		color: var(--color-brand);
	}
</style>
