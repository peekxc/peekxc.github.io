---
import { Icon } from 'astro-icon/components';
import ProjectCardImage from './ProjectCardImage.astro';

interface Props {
  title: string;
  subtitle: string;
  tags: string[];
  image?: string;
  highlightDate?: string;
}
const { title, subtitle, tags, image, highlightDate } = Astro.props as Props;
const hasMedia = Boolean(image);
const panelId = `project-panel-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<article data-project-card class="not-prose group w-full cursor-pointer rounded-lg border border-slate-200 bg-white/90 shadow-sm transition hover:shadow-md">
  <div class="flex flex-col text-slate-900">
    <button
      type="button"
      class="w-full border-b border-slate-200 bg-white/95 px-4 py-3 text-left transition-colors hover:bg-slate-50"
      data-accordion-trigger
      aria-controls={panelId}
      aria-expanded="false"
    >
    <div class="grid grid-cols-1 gap-3 md:grid-cols-5 md:items-stretch">
      <div class="md:col-span-3">
        <h3 class="mb-2 mt-0 text-xl font-semibold leading-snug">{title}</h3>
        <p class="my-1 text-small uppercase leading-tight text-slate-500">{subtitle})</p>
        <p class="bottom-2 right-2 text-[0.85rem] font-semibold uppercase tracking-[0.2em] text-slate-800/80">{highlightDate ?? 'ongoing'}</p>
      </div>

      {hasMedia && (
        <div data-header-collapsible class="grid grid-rows-[1fr] transition-all duration-200 ease-out md:col-span-2">
          <div class="overflow-hidden">
            <div class="relative h-44 overflow-hidden rounded-lg">
              <ProjectCardImage
                imagePath={image}
                alt={title}
                className="m-0 h-full w-full object-scale-down"
              />
            </div>
          </div>
        </div>
      )}
    </div>

    <div class="mt-2 grid grid-cols-[1fr_auto] items-center gap-2">
      <div data-header-collapsible class="grid grid-rows-[1fr] transition-all duration-200 ease-out">
        <div class="overflow-hidden">
          <div class="flex flex-wrap gap-1 text-slate-600">
            {tags.map((tag) => (
              <span class="rounded-md border border-slate-200 px-2 py-0.5 text-xs font-semibold tracking-[0.1em]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
      <span class="chevron-icon inline-flex transition-transform duration-200 ease-out">
        <Icon name="chevron" width="18" height="18" />
      </span>
    </div>
			
  </button>
    <div
      id={panelId}
      data-accordion-content
      data-open="false"
      class="accordion-content grid grid-rows-[0fr] bg-slate-50/40 transition-all duration-200 ease-out"
    >
      <div class="overflow-hidden">
        <div class="space-y-2 px-4 py-4">
          <slot />
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  const initProjectAccordions = () => {
    document.querySelectorAll('[data-project-card]').forEach((card) => {
      if (card.getAttribute('data-accordion-bound') === 'true') return;

      const trigger = card.querySelector('[data-accordion-trigger]');
      const content = card.querySelector('[data-accordion-content]');
      const icon = card.querySelector('.chevron-icon');
      if (!trigger || !content) return;

      const toggleAccordion = () => {
        const isOpen = content.getAttribute('data-open') === 'true';
        const headerCollapsibles = card.querySelectorAll('[data-header-collapsible]');
        content.setAttribute('data-open', isOpen ? 'false' : 'true');
        content.classList.toggle('grid-rows-[1fr]', !isOpen);
        content.classList.toggle('grid-rows-[0fr]', isOpen);
        headerCollapsibles.forEach((section) => {
          section.classList.toggle('grid-rows-[0fr]', !isOpen);
          section.classList.toggle('grid-rows-[1fr]', isOpen);
        });
        icon?.classList.toggle('rotate-180', !isOpen);
        trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      };

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleAccordion();
      });

      card.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (target.closest('a')) return;
        toggleAccordion();
      });

      card.setAttribute('data-accordion-bound', 'true');
    });
  };

  initProjectAccordions();
  document.addEventListener('astro:page-load', initProjectAccordions);
</script>
