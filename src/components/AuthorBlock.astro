---
const { title, date, categories = [] } = Astro.props;
const options = { year: 'numeric', month: 'long', day: 'numeric' };
---
<header class="mb-12 text-center">
  <h1>
    {title}
  </h1>
  <p class="my-3 text-sm font-medium uppercase tracking-[0.18em] text-ink-muted">
    Matt Piekenbrock&nbsp;&nbsp;·&nbsp;&nbsp;{date.toLocaleDateString("en-US", options)}
  </p>
  <div class="mt-3 flex flex-wrap justify-center gap-1.5">
    {categories.map(cat => (
      <span class="rounded-card border border-line-soft bg-surface-muted px-2 py-0.5 text-xs font-semibold text-ink-muted">
        {cat}
      </span>
    ))}
  </div>

  <div class="mx-auto mt-8 h-px max-w-32 bg-line-soft"></div>
</header>
