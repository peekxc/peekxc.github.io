---
const { title, date, categories = [] } = Astro.props;
const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
---
<header class="text-center my-2">
  <h1 class="text-4xl font-bold tracking-tight mt-4 mb-3 italic">
    {title}
  </h1>
  <p class="text-md font-normal text-slate-600 my-2">
    Matt Piekenbrock&nbsp;&nbsp;·&nbsp;&nbsp;{date.toLocaleDateString("en-US", options)}
  </p>
  <div class="mt-0 space-x-1">
    {categories.map(cat => (
      <span class="px-2 py-0.5 text-xs rounded border border-slate-300">
        {cat}
      </span>
    ))}
  </div>

  <div class="mt-2 border-b border-slate-200"></div>
</header>