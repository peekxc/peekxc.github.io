<div class="mt-6 flex items-center justify-end gap-2">
  <button
    id="projects-expand-all"
    type="button"
    class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-slate-700 transition hover:border-slate-300 hover:text-slate-900"
  >
    Expand all
  </button>
  <button
    id="projects-collapse-all"
    type="button"
    class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-slate-700 transition hover:border-slate-300 hover:text-slate-900"
  >
    Collapse all
  </button>
</div>

<script>
  const setProjectAccordionState = (card, open) => {
    const content = card.querySelector('[data-accordion-content]');
    const icon = card.querySelector('.chevron-icon');
    const trigger = card.querySelector('[data-accordion-trigger]');
    const headerCollapsibles = card.querySelectorAll('[data-header-collapsible]');
    if (!content || !trigger) return;

    content.setAttribute('data-open', open ? 'true' : 'false');
    content.classList.toggle('grid-rows-[1fr]', open);
    content.classList.toggle('grid-rows-[0fr]', !open);
    headerCollapsibles.forEach((section) => {
      section.classList.toggle('grid-rows-[0fr]', open);
      section.classList.toggle('grid-rows-[1fr]', !open);
    });
    icon?.classList.toggle('rotate-180', open);
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  const bindProjectPageControls = () => {
    const expandBtn = document.getElementById('projects-expand-all');
    const collapseBtn = document.getElementById('projects-collapse-all');
    if (!expandBtn || !collapseBtn) return;
    if (expandBtn.getAttribute('data-bound') === 'true') return;

    expandBtn.addEventListener('click', () => {
      document.querySelectorAll('[data-project-card]').forEach((card) => {
        setProjectAccordionState(card, true);
      });
    });

    collapseBtn.addEventListener('click', () => {
      document.querySelectorAll('[data-project-card]').forEach((card) => {
        setProjectAccordionState(card, false);
      });
    });

    expandBtn.setAttribute('data-bound', 'true');
  };

  bindProjectPageControls();
  document.addEventListener('astro:page-load', bindProjectPageControls);
</script>
