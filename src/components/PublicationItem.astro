---
interface Props {
  authors: string;
  title: string;
  journal?: string;
  year?: string | number;
  doi?: string;
  href?: string;
}

const { authors, title, journal, year, doi, href } = Astro.props as Props;
const doiHref = doi
  ? (doi.startsWith('http://') || doi.startsWith('https://') ? doi : `https://doi.org/${doi}`)
  : undefined;
const doiLabel = doi ? doi.replace(/^https?:\/\/doi\.org\//, '') : undefined;
---

<article class="surface-panel px-4 py-2 text-sm leading-snug text-ink">
  {href ? (
    <a class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-ink-strong underline decoration-line-strong underline-offset-2 transition hover:text-brand hover:decoration-brand" href={href} target="_blank" rel="noreferrer">
      {title}
    </a>
  ) : (
    <p class="mt-1 text-sm font-semibold text-ink-strong">{title}</p>
  )}
	<p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">{authors}</p>
  <div class="mt-1 flex items-end justify-between gap-2">
    <p class="text-xs italic text-ink-muted">
      {journal}{journal && year ? ', ' : ''}{year}
    </p>
    {doiHref && (
      <a
        class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted underline decoration-line-strong underline-offset-2 transition hover:text-brand hover:decoration-brand"
        href={doiHref}
        target="_blank"
        rel="noreferrer"
      >
        DOI {doiLabel}
      </a>
    )}
  </div>
</article>
