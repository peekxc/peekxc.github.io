---
interface Props {
  title?: string;
	description?: string;
	canonical?: string;
}
const { 
	title = "Matt Piekenbrock website",
	description = "Personal website of Matthew Piekenbrock - research, background, curriculum vitae, and work experience.",
	canonical = Astro.url.pathname,
} = Astro.props;
const canonical_url = new URL(canonical, Astro.site).toString();
---
<head>
  <title> {title} </title>
  <meta charset="utf-8"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="viewport" content="initial-scale=1.0, width=device-width, viewport-fit=cover"/>
  <meta name="author" content="Matthew Piekenbrock"/>
	<meta name="description" content={description}/>
  <link rel="canonical" href={canonical_url}/>
  <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml"/>
  <slot />
  <!-- <link rel="stylesheet" type="text/css" href="/styles/tw_styles.css"/> -->
  <!-- <link rel="stylesheet" type="text/css" href="/styles/overrides.css"/> -->
</head>
