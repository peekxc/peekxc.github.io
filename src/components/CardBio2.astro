---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ProfileImage from "../assets/images/profile_pic_blue.jpg"
---

<div class="max-w-2xl mx-auto overflow-hidden surface-card-interactive flex flex-col md:flex-row items-center md:items-stretch">
  
  <div class="w-full md:w-1/3 relative overflow-hidden group">
    <Picture 
      src={ProfileImage} 
      alt="Matt Piekenbrock"
      width="512"
      formats={['avif', 'webp']} 
      class="h-full w-full object-cover aspect-square md:aspect-auto transform transition-transform duration-500 group-hover:scale-105"
      loading="eager"
    />
  </div>

<div class="p-8 md:p-4 flex-1 flex flex-col">
    <div class="flex-1">
      <slot/>
    </div>

    <div class="flex flex-row justify-between items-stretch mt-auto pt-2 border-t border-line-soft">
      <a 
        href="/cv_7.pdf" 
        class="px-5 py-2.5 bg-ink-strong text-white rounded-card font-semibold text-sm transition-all hover:bg-brand-hover hover:scale-105 active:scale-95 flex items-center gap-2 focus-ring"
      >
        <!-- <Icon name="mdi:file-document-outline" class="text-lg" /> -->
        View CV
      </a>

      <div class="flex items-center gap-4">
        <a href="https://github.com/peekxc" class="cv-bio-icon" aria-label="git-ref">
          <Icon name="github" class="text-2xl"/>
        </a>
        <a href="https://www.linkedin.com/in/matthew-piekenbrock-1469777a/" class="cv-bio-icon" aria-label="linkedin-ref">
          <Icon name="linkedin" class="text-2xl" />
        </a>
        <a href="https://scholar.google.com/citations?user=2lPQ3UQAAAAJ&hl=en" class="cv-bio-icon" aria-label="scholar-ref">
          <Icon name="scholar" class="text-2xl" />
        </a>
      </div>
    </div>
  </div>
</div>

<style scoped>
.cv-bio-link {
	color: var(--color-ink-strong);
	font-weight: 600;
	transition: color 150ms ease;
}

.cv-bio-link:hover,
.cv-bio-link:focus-visible {
	color: var(--color-brand);
}

.cv-bio-icon {
	color: #94a3b8;
	transition: color 150ms ease;
}

.cv-bio-icon:hover,
.cv-bio-icon:focus-visible {
	color: var(--color-brand-hover);
}
</style>
