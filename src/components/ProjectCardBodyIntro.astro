---
import ProjectCardImage from './ProjectCardImage.astro';

interface Props {
  imagePath?: string;
  alt: string;
  abstract: string;
  imageWidthPercent?: number;
}

const { imagePath, alt, abstract, imageWidthPercent = 50 } = Astro.props as Props;
const hasImage = Boolean(imagePath);
const clampedWidth = Math.min(80, Math.max(20, imageWidthPercent));
---

<div
  class={`project-card-body-intro grid grid-cols-1 gap-3 ${hasImage ? '' : 'no-image'}`}
  style={`--project-intro-image-width: ${clampedWidth}%;`}
>
  {hasImage && (
    <ProjectCardImage
      imagePath={imagePath}
      alt={alt}
      className="h-52 w-full media-frame object-contain"
    />
  )}
  <div class={`surface-panel p-3 ${hasImage ? 'max-h-52 overflow-y-auto' : ''}`}>
    <p class="m-0 text-sm leading-snug text-ink">{abstract}</p>
  </div>
</div>

<style>
  @media (min-width: 768px) {
    .project-card-body-intro {
      grid-template-columns: var(--project-intro-image-width) minmax(0, 1fr);
    }

    .project-card-body-intro.no-image {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
