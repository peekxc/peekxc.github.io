---
interface Badge {
  src: string
  alt?: string
  href?: string
}

interface Bullet {
  name: string
  href: string
  badges?: Badge[]
}

const { bullets = [] } = Astro.props
---

<div class="overflow-auto py-2 text-sm leading-snug text-ink">
	<ul class="list-disc pl-4 not-prose">
		{bullets.map((p) => (
			<li class="list-item py-0.5 [display:list-item]">
				<div class="flex justify-between items-center">
					<a href={p.href} class="font-semibold text-ink-strong underline decoration-line-strong underline-offset-3 transition hover:text-brand hover:decoration-brand">{p.name}</a>
					<div class="flex gap-2">
						{p.badges?.map((b) => (
							<a href={b.href} class="focus-ring">
								<img src={b.src} alt={b.alt ?? ''} class="inline h-4" />
							</a>
						))}
					</div>
				</div>
			</li>
		))}
	</ul>	
	<slot/>
</div>
