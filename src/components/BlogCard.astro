---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  post: CollectionEntry<'blog_posts'>;
}

const { post } = Astro.props as Props;
const frontmatter = post.data;
const hasImage = Boolean(frontmatter.background_image);
const fallbackGradient = 'linear-gradient(135deg, #e2e8f0, #fecdd3)';
const imageSrc = hasImage ? frontmatter.background_image : fallbackGradient;
const publishedDate = frontmatter.date
  ? new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', }) : '';
const summary = frontmatter.abstract ?? frontmatter.description ?? '';
const labels: string[] = frontmatter.categories?.length
  ? frontmatter.categories
  : frontmatter.tags ?? [];

	const images = import.meta.glob<{ default: ImageMetadata }>(
  // '/src/assets/images/**/*.{png,jpg,jpeg,webp,avif,gif}',
	'/src/content/posts/**/*.{png,jpg,jpeg,webp,avif,gif}',
  { eager: true }
);
const imageEntry = imageSrc ? images[imageSrc] : undefined;
// const imageMeta = imageEntry?.default;
const imageKey = frontmatter.background_image?.startsWith('/')
  ? frontmatter.background_image
  : `/src/content/posts/${frontmatter.background_image}`;

const imageMeta = imageKey ? images[imageKey]?.default : undefined;
---
<a
  href={`/blog/${post.data.slug}`}
  class="group block overflow-hidden surface-card-interactive transition duration-200 hover:-translate-y-0.5 focus-ring"
  aria-label={`Read ${frontmatter.title}`}
>
  <article class="grid gap-6 p-5 md:grid-cols-[3fr_2fr]">
    <div class="flex flex-col gap-3 h-full">
      <p class="eyebrow">
        {publishedDate || 'Blog'}
      </p>
      <h3 class="text-2xl font-semibold leading-snug text-ink-strong transition-colors group-hover:text-brand">
        {frontmatter.title}
      </h3>
      {summary && (
        <p
          class="text-sm text-ink-muted"
          style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
        >
          {summary}
        </p>
      )}

      <div class="mt-auto flex flex-wrap gap-1">
        {labels.map((label: string) => (
          <span class="tag" aria-label={label}>
            {label}
          </span>
        ))}
      </div>
    </div>

    <div class="relative -m-2 h-48 media-frame bg-gradient-to-br from-slate-100 via-white to-slate-100 shadow-inner">
      {imageMeta ? (
        <Image
          alt={`Preview for ${frontmatter.title}`}
          src={imageMeta}
          formats={['avif', 'webp']}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center eyebrow"
          style={`background-image: ${fallbackGradient}`}
        >
          {labels[0] ?? 'Insight'}
        </div>
      )}
    </div>
  </article>
</a>
