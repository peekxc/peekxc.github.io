---
interface SectionItem {
  label: string;
  href?: string;
  meta?: string;
}

interface Section {
  title: string;
  items: SectionItem[];
}

interface Badge {
  src: string;
  href?: string;
  alt?: string;
  height?: number;
}

interface CodeLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  summary: string;
  description?: string;
  docLink?: string;
  repoLink?: string;
  categories?: string[];
  tags?: string[];
  badges?: Badge[];
  codeLinks?: CodeLink[];
  sections?: Section[];
}

const {
  title,
  summary,
  description,
  docLink,
  repoLink,
  categories = [],
  tags = [],
  badges = [],
  codeLinks = [],
  sections = []
} = Astro.props as Props;
const rgbStroke = 'rgba(255,255,255,0.35)';
---

<article class="w-full rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="flex flex-col gap-2 px-4 py-4 text-slate-900">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-[0.6rem] uppercase tracking-[0.4em] text-slate-500">Code</p>
        <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {docLink && (
          <a
            class="rounded-full border border-slate-400 px-3 py-1 text-[0.55rem] font-bold uppercase tracking-[0.3em] text-slate-600 transition hover:bg-slate-900 hover:text-white"
            href={docLink}
            target="_blank"
            rel="noreferrer"
          >
            Docs
          </a>
        )}
        {repoLink && (
          <a
            class="rounded-full border border-slate-400 px-3 py-1 text-[0.55rem] font-bold uppercase tracking-[0.3em] text-slate-600 transition hover:bg-slate-900 hover:text-white"
            href={repoLink}
            target="_blank"
            rel="noreferrer"
          >
            Repo
          </a>
        )}
      </div>
    </div>

    <p class="text-sm leading-relaxed text-slate-700">{summary}</p>
    {description && <p class="text-sm leading-relaxed text-slate-700">{description}</p>}

    <div class="flex flex-wrap gap-2">
      {categories.map((category) => (
        <span class="tag bg-white/10 text-white">{category}</span>
      ))}
    </div>

    <div class="flex flex-wrap gap-2">
      {badges.map((badge) => (
        <a href={badge.href ?? '#'} target="_blank" rel="noreferrer" class="rounded-full border border-slate-200 px-2 py-1 text-[0.55rem] font-semibold tracking-[0.3em] text-slate-500 transition hover:border-slate-400">
          <img src={badge.src} alt={badge.alt ?? badge.href} height={badge.height ?? 16} class="inline-block" />
        </a>
      ))}
    </div>

    <div class="grid gap-2 md:grid-cols-2">
      {codeLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noreferrer"
          class="rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2 text-[0.6rem] font-semibold uppercase tracking-[0.3em] text-slate-700 transition hover:border-slate-400 hover:bg-slate-100"
        >
          {link.label}
        </a>
      ))}
    </div>

    {sections.map((section) => (
      <section class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
        <div class="mb-2 text-xs uppercase tracking-[0.3em] text-slate-200">{section.title}</div>
        <ul class="space-y-1">
          {section.items.map((item) => (
            <li>
              {item.href ? (
                <a class="font-semibold text-slate-900 transition hover:text-primary" href={item.href} target="_blank" rel="noreferrer">
                  {item.label}
                </a>
              ) : (
                <span class="font-semibold text-slate-900">{item.label}</span>
              )}
              {item.meta && <span class="ml-2 text-xs uppercase tracking-[0.3em] text-slate-500">{item.meta}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="flex flex-wrap gap-2 text-xs uppercase tracking-[0.3em] text-slate-500">
      {tags.map((tag) => (
        <span class="rounded-full border border-slate-200 px-2 py-1 text-slate-600">{tag}</span>
      ))}
    </div>
  </div>
</article>
