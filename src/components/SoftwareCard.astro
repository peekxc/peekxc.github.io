---
interface SectionItem {
  label: string;
  href?: string;
  meta?: string;
}

interface Section {
  title: string;
  items: SectionItem[];
}

interface Badge {
  src: string;
  href?: string;
  alt?: string;
  height?: number;
}

interface CodeLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  summary: string;
  description?: string;
  docLink?: string;
  repoLink?: string;
  categories?: string[];
  tags?: string[];
  badges?: Badge[];
  codeLinks?: CodeLink[];
  sections?: Section[];
}

const {
  title,
  summary,
  description,
  docLink,
  repoLink,
  categories = [],
  tags = [],
  badges = [],
  codeLinks = [],
  sections = []
} = Astro.props as Props;
---

<article class="w-full surface-card">
  <div class="flex flex-col gap-2 px-4 py-4 text-ink-strong">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-[0.6rem] uppercase tracking-[0.4em] text-ink-muted">Code</p>
        <h3 class="text-lg font-semibold text-ink-strong">{title}</h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {docLink && (
          <a
            class="rounded-full border border-line-strong px-3 py-1 text-[0.55rem] font-bold uppercase tracking-[0.3em] text-ink-muted transition hover:bg-ink-strong hover:text-white focus-ring"
            href={docLink}
            target="_blank"
            rel="noreferrer"
          >
            Docs
          </a>
        )}
        {repoLink && (
          <a
            class="rounded-full border border-line-strong px-3 py-1 text-[0.55rem] font-bold uppercase tracking-[0.3em] text-ink-muted transition hover:bg-ink-strong hover:text-white focus-ring"
            href={repoLink}
            target="_blank"
            rel="noreferrer"
          >
            Repo
          </a>
        )}
      </div>
    </div>

    <p class="text-sm leading-relaxed text-ink">{summary}</p>
    {description && <p class="text-sm leading-relaxed text-ink">{description}</p>}

    <div class="flex flex-wrap gap-2">
      {categories.map((category) => (
        <span class="tag">{category}</span>
      ))}
    </div>

    <div class="flex flex-wrap gap-2">
      {badges.map((badge) => (
        <a href={badge.href ?? '#'} target="_blank" rel="noreferrer" class="rounded-full border border-line px-2 py-1 text-[0.55rem] font-semibold tracking-[0.3em] text-ink-muted transition hover:border-line-strong focus-ring">
          <img src={badge.src} alt={badge.alt ?? badge.href} height={badge.height ?? 16} class="inline-block" />
        </a>
      ))}
    </div>

    <div class="grid gap-2 md:grid-cols-2">
      {codeLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noreferrer"
          class="surface-panel px-3 py-2 text-[0.6rem] font-semibold uppercase tracking-[0.3em] text-ink transition hover:border-line-strong hover:bg-surface-muted focus-ring"
        >
          {link.label}
        </a>
      ))}
    </div>

    {sections.map((section) => (
      <section class="surface-panel p-4 text-sm text-ink">
        <div class="mb-2 text-xs uppercase tracking-[0.3em] text-ink-subtle">{section.title}</div>
        <ul class="space-y-1">
          {section.items.map((item) => (
            <li>
              {item.href ? (
                <a class="font-semibold text-ink-strong transition hover:text-brand focus-ring" href={item.href} target="_blank" rel="noreferrer">
                  {item.label}
                </a>
              ) : (
                <span class="font-semibold text-ink-strong">{item.label}</span>
              )}
              {item.meta && <span class="ml-2 text-xs uppercase tracking-[0.3em] text-ink-muted">{item.meta}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="flex flex-wrap gap-2 text-xs uppercase tracking-[0.3em] text-ink-muted">
      {tags.map((tag) => (
        <span class="rounded-full border border-line px-2 py-1 text-ink-muted">{tag}</span>
      ))}
    </div>
  </div>
</article>
