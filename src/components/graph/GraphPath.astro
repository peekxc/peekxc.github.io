---
---

<div id="cy" style="width:100%;height:420px;"></div>

<script type="module">
// import cytoscape from "cytoscape";
import cytoscape from "https://cdn.jsdelivr.net/npm/cytoscape@3.28.1/+esm";

const cy = cytoscape({
  container: document.getElementById("cy"),
	zoomingEnabled: false,
  userZoomingEnabled: false,
  panningEnabled: false,
  userPanningEnabled: false,
  boxSelectionEnabled: false,
  autoungrabify: true,
  autounselectify: true,
  elements: [
    { data: { id: "a" }, position: { x: 50, y: 50 } },
    { data: { id: "b" }, position: { x: 180, y: 60 } },
    { data: { id: "c" }, position: { x: 120, y: 150 } },
    { data: { id: "d" }, position: { x: 260, y: 160 } },

    { data: { id: "ab", source: "a", target: "b" } },
    { data: { id: "bc", source: "b", target: "c" } },
    { data: { id: "ac", source: "a", target: "c" } },
    { data: { id: "bd", source: "b", target: "d" } },
    { data: { id: "cd", source: "c", target: "d" } }
  ],
   style: [
    {
      selector: "node",
      style: {
        label: "data(weight)",
        width: 10,
        height: 10,
        "background-color": "#666",
        "text-valign": "top",
        "text-halign": "center",
        "font-size": 10,
        "text-margin-y": -8
      }
    },
    {
      selector: "edge",
      style: {
        width: 2,
        "line-color": "#999"
      }
    },
    {
      selector: ".highlight_edge",
      style: {
        width: 5,
        "line-color": "orange"
      }
    },
    {
      selector: ".highlight_node",
      style: {
        width: 14,
        height: 14,
        "background-color": "orange"
      }
    },
    {
      selector: ".path_node",
      style: {
        "background-color": "orange"
      }
    }
  ],
  layout: { name: "preset" }
});

let picked = [];

cy.on("tap", "node", (e) => {
  const node = e.target;

  if (picked.length === 2) picked = [];
  picked.push(node);

  cy.elements().removeClass("highlight_edge highlight_node path_node");
  picked.forEach((n) => n.addClass("highlight_node"));

  if (picked.length === 2) {
    const d = cy.elements().dijkstra(picked[0]);
    const path = d.pathTo(picked[1]);
    path.addClass("highlight_edge");
    path.nodes().addClass("path_node");
    picked.forEach((n) => n.addClass("highlight_node"));
  }
});
</script>