---
import Base from "../layouts/base.astro";
const { posts } = Astro.props;
---

<Base>
<main class="flex flex-row w-full min-h-screen">
  <aside class="hidden w-0 lg:flex lg:w-1/6"></aside>

  <div class="flex flex-col w-full lg:w-4/6">
    <div class="flex w-full">
      <button id="cardBtn" class="p-2 text-gray-500 hover:text-gray-700" onclick="showView('card')">
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M2.625 6.75a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0A.75.75 0 0 1 8.25 6h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75ZM2.625 12a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0ZM7.5 12a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12A.75.75 0 0 1 7.5 12Zm-4.875 5.25a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75Z"/>
        </svg>
      </button>

      <button id="compactBtn" class="p-2 text-gray-500 w-2 hover:text-gray-700" onclick="showView('compact')">
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 6h18M3 14h18M3 18h18"/>
        </svg>
      </button>
    </div>

    <ul class="list-desc relative overflow-auto space-y-2 prose-lg">
      <div id="cardView" class="w-full">
        {posts.map(post =>
          !post.data.draft && (
            <li class="px-2 md:px-0">
              <a href={post.url} class="duration-250 flex overflow-hidden rounded-lg border bg-white shadow-sm transition hover:cursor-pointer hover:bg-gray-100 dark:bg-gray-800 dark:hover:bg-gray-700" style="min-height:150px;max-height:220px">
                <div class="px-3 py-2 flex flex-col md:w-3/5">
                  <div class="mb-2 text-xl font-bold text-gray-900 dark:text-white">{post.data.title}</div>
                  <p class="m-0 text-base overflow-hidden text-gray-700 dark:text-gray-400">{post.data.abstract}</p>
                  <div class="mt-auto">
                    <span class="inline-block calendar_icon h-3 w-3"></span>
                    <span class="inline-block mx-2 text-xs">{post.data.date}</span>
                    <span class="inline-block tag_icon h-3 w-3"></span>
                    <span class="mx-2 text-xs text-gray-500">{post.data.categories.join(", ")}</span>
                  </div>
                </div>
                <div class="m-0 border-l hidden md:flex md:w-2/5 overflow-hidden" style="min-height:150px">
                  <img class="m-0 object-cover h-full" src={post.data.background_image} alt="Card Image" loading="lazy" />
                </div>
              </a>
            </li>
          )
        )}
      </div>

      <div id="compactView" class="flex flex-col hidden mt-0">
        {posts.map(post =>
          !post.data.draft && (
            <li class="min-w-max w-full border px-2 py-1 bg-white duration-250 transition md:px-1 hover:cursor-pointer hover:bg-gray-100">
              <a href={post.url} class="shadow-sm">
                <div class="mb-0 text-lg font-bold text-gray-900 dark:text-white">{post.data.title}</div>
                <div class="flex flex-row items-center">
                  <span class="inline-block calendar_icon h-3 w-3"></span>
                  <span class="inline-block mx-2 text-xs">{post.data.date}</span>
                  <span class="inline-block tag_icon h-3 w-3"></span>
                  <span class="mx-2 text-xs text-gray-500">{post.data.categories.join(", ")}</span>
                </div>
              </a>
            </li>
          )
        )}
      </div>
    </ul>
  </div>

  <aside class="hidden w-0 lg:flex lg:w-1/6"></aside>
</main>

<script is:inline>
  function showView(view) {
    document.getElementById("compactView").classList.add("hidden");
    document.getElementById("cardView").classList.add("hidden");
    document.getElementById(`${view}View`).classList.remove("hidden");
  }
</script>
</Base>
